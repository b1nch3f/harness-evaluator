# Agent model profile "AGENT" (the default for `sb eval --agent`).
# Add another LLM as another prefix (e.g. QWEN_MODEL, QWEN_API_BASE, QWEN_API_KEY)
# and select it with `sb eval <exp> --agent QWEN`.
AGENT_MODEL=openai/openai/gpt-oss-120b
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_TEMPERATURE=0.0
AGENT_REASONING_EFFORT=medium

# tau2 user simulator (keep fixed for the whole experiment).
# gpt-oss-120b on the same RunPod endpoint: scores are not comparable with
# published tau2 results (which use gpt-4.1), but A vs B comparisons hold.
USER_MODEL=openai/openai/gpt-oss-120b
USER_API_BASE=
USER_API_KEY=
USER_TEMPERATURE=0.0
USER_REASONING_EFFORT=medium

# Assertion judge (temperature fixed at 0). Empty = use the USER_* settings.
JUDGE_MODEL=
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_REASONING_EFFORT=

# Weights & Biases
WANDB_PROJECT=harness-evaluator
WANDB_ENTITY=
WANDB_API_KEY=

# Optional per profile (AGENT_, USER_, JUDGE_ or any --agent profile such as GLM_):
#   <P>_TOP_P=0.95        sampling top_p (default: provider default)
#   <P>_MAX_TOKENS=16384  output cap per reply (default: provider default)
#   <P>_TIMEOUT=300       seconds per request (default 600, for serverless cold starts)
