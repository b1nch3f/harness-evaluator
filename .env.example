# Agent model (gpt-oss-120b behind an OpenAI-compatible endpoint, via LiteLLM)
AGENT_MODEL=openai/gpt-oss-120b
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_TEMPERATURE=0.0
AGENT_REASONING_EFFORT=medium

# tau2 user simulator (keep fixed for the whole experiment)
USER_MODEL=gpt-4.1
USER_API_BASE=
USER_API_KEY=
USER_TEMPERATURE=0.0

# Run settings
MAX_STEPS=100
CONCURRENCY=16

# Weights & Biases
WANDB_PROJECT=automatic-agent-skills-builder
WANDB_ENTITY=
WANDB_API_KEY=
